# Supabase — maak een gratis project op supabase.com
SUPABASE_URL=https://jouw-project.supabase.co
SUPABASE_SERVICE_KEY=jouw-service-role-key

# UiTdatabank — optioneel, voor hogere rate limits
UITDATABANK_API_KEY=

# Bandsintown
BANDSINTOWN_APP_ID=kulturr

# Ticketmaster — gratis account op developer.ticketmaster.com
TICKETMASTER_API_KEY=

# Server
PORT=3000
# ── Affiliate (optioneel) ────────────────────────────────────────────────────
# Registreer op cj.com, zoek Ticketmaster Belgium, vraag toegang.
# Vul in zodra je approved bent — zonder deze vars worden gewone links gebruikt.
CJ_PUBLISHER_ID=
CJ_TICKETMASTER_AID=
